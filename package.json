{
  "name": "edupro",
  "version": "1.0.0",
  "private": true,
  "description": "EduPro — Multi-tenant Academic Management SaaS",
  "scripts": {
    "dev": "concurrently \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm --prefix backend run start:dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:setup": "ts-node --transpile-only -O \"{\\\"module\\\":\\\"commonjs\\\",\\\"esModuleInterop\\\":true,\\\"experimentalDecorators\\\":true,\\\"emitDecoratorMetadata\\\":true,\\\"target\\\":\\\"ES2022\\\",\\\"resolveJsonModule\\\":true,\\\"strict\\\":false}\" backend/scripts/setup-databases.ts",
    "seed:plans": "ts-node --transpile-only -O \"{\\\"module\\\":\\\"commonjs\\\",\\\"esModuleInterop\\\":true,\\\"experimentalDecorators\\\":true,\\\"emitDecoratorMetadata\\\":true,\\\"target\\\":\\\"ES2022\\\",\\\"resolveJsonModule\\\":true,\\\"strict\\\":false}\" backend/scripts/seed-plans.ts",
    "seed:superadmin": "ts-node --transpile-only -O \"{\\\"module\\\":\\\"commonjs\\\",\\\"esModuleInterop\\\":true,\\\"experimentalDecorators\\\":true,\\\"emitDecoratorMetadata\\\":true,\\\"target\\\":\\\"ES2022\\\",\\\"resolveJsonModule\\\":true,\\\"strict\\\":false}\" backend/scripts/seed-superadmin.ts",
    "seed": "npm run seed:plans && npm run seed:superadmin",
    "migration:generate": "npm --prefix backend run migration:generate",
    "migration:run": "npm --prefix backend run migration:run",
    "migration:revert": "npm --prefix backend run migration:revert"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "packageManager": "pnpm@9.15.9+sha512.68046141893c66fad01c079231128e9afb89ef87e2691d69e4d40eee228988295fd4682181bae55b58418c3a253bde65a505ec7c5f9403ece5cc3cd37dcf2531"
}
