# Normalize all text files to LF in the repository (and on checkout),
# regardless of the contributor's OS — keeps diffs clean across Windows/Linux.
* text=auto eol=lf

# Shell scripts must stay LF to run on the server.
*.sh text eol=lf

# Binary assets — never touch line endings.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.pdf  binary
*.woff  binary
*.woff2 binary
*.ttf  binary
*.eot  binary
